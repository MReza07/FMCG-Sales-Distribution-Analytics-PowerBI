{
  "name": "FMCG Professional Navy Gold",
  "dataColors": [
    "#1F3864",
    "#C9A227",
    "#2A9D8F",
    "#5B7DB1",
    "#E07A32",
    "#8B95A5",
    "#A9C1E8",
    "#2E7D32"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1F3864",
  "good": "#2E7D32",
  "neutral": "#C9A227",
  "bad": "#C62828",
  "maximum": "#1F3864",
  "center": "#C9A227",
  "minimum": "#A9C1E8",
  "null": "#9CA3AF",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1F3864" },
    "title": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#1F3864" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F3864" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#4B5563" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6FA" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#1F3864" } },
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 14,
          "alignment": "left"
        }],
        "subTitle": [{
          "fontColor": { "solid": { "color": "#6B7280" } },
          "fontFamily": "Segoe UI",
          "fontSize": 10
        }],
        "background": [{
          "show": true,
          "color": { "solid": { "color": "#FFFFFF" } },
          "transparency": 0
        }],
        "border": [{
          "show": true,
          "color": { "solid": { "color": "#E5E7EB" } },
          "radius": 8
        }],
        "visualHeader": [{ "show": false }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#4B5563" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI"
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#4B5563" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI",
          "gridlineColor": { "solid": { "color": "#E5E7EB" } }
        }],
        "legend": [{
          "labelColor": { "solid": { "color": "#4B5563" } },
          "fontSize": 10,
          "position": "Top"
        }]
      }
    },
    "card": {
      "*": {
        "labels": [{
          "color": { "solid": { "color": "#1F3864" } },
          "fontSize": 24,
          "fontFamily": "Segoe UI Semibold"
        }],
        "categoryLabels": [{
          "color": { "solid": { "color": "#4B5563" } },
          "fontSize": 11
        }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "backColor": { "solid": { "color": "#1F3864" } },
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 11,
          "bold": true
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#1F2937" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "backColorSecondary": { "solid": { "color": "#F9FAFB" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI"
        }],
        "total": [{
          "fontColor": { "solid": { "color": "#1F3864" } },
          "backColor": { "solid": { "color": "#E5E7EB" } },
          "bold": true
        }],
        "grid": [{
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#E5E7EB" } },
          "gridVertical": false
        }]
      }
    },
    "slicer": {
      "*": {
        "header": [{
          "show": true,
          "fontColor": { "solid": { "color": "#1F3864" } },
          "fontSize": 12,
          "bold": true
        }],
        "items": [{
          "fontColor": { "solid": { "color": "#1F3864" } },
          "background": { "solid": { "color": "#FFFFFF" } },
          "fontSize": 11
        }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2.5, "showMarker": true, "markerSize": 5 }]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#1F3864" } } }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#374151" } }, "fontSize": 9 }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#1F3864" } } }]
      }
    }
  }
}
